{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["DOM", "ES2020"],
    "rootDir": "src/ts",
    "outDir": "src/js",
    "strict": false,
    "ignoreDeprecations": "6.0",
    "noEmitOnError": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/ts/**/*.ts"]
}

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": [
      "DOM",
      "ES2020"
    ],
    "rootDir": "src/ts",
    "outDir": "src/js",
    "strict": true,
    "ignoreDeprecations": "6.0",
    "noEmitOnError": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": [
    "src/ts/**/*.ts"
  ]
}

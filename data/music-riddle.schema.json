{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Music Riddle v1",
  "description": "单份 JSON 定义一个音乐谜题。结构由编辑器检查，ID、路径、可达性和答案冲突由 scripts/music_riddle_data.py 检查。",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "description": "稳定节点 ID；改歌名时保持不变。"
    },
    "artist": {
      "type": "object",
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false
    },
    "title": {
      "type": "object",
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false
    },
    "date": {
      "type": "string",
      "minLength": 1,
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "restored": {
      "type": "string",
      "minLength": 1,
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "format": "uri"
    },
    "start": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "description": "稳定节点 ID；改歌名时保持不变。"
    },
    "ending": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "description": "稳定节点 ID；改歌名时保持不变。"
    },
    "map": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "routes": {
          "type": "object",
          "description": "可选的平滑连线路径。键为 起点ID:终点ID，值为经过的坐标点；不改变歌曲的 next 关系。",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1
    },
    "bonus": {
      "type": "string",
      "description": "集齐所有其他节点后自动解锁的隐藏回响 ID。"
    },
    "finale": {
      "type": "object",
      "description": "集齐所有歌曲时自动播放的编排曲：一串节点和弦，每个节点随自己的和弦亮起、暗下。最后一步必须是隐藏尾声（没有隐藏尾声时是终点）。",
      "properties": {
        "beat": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 1.5,
          "description": "每拍的秒数。"
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 128,
          "items": {
            "type": "object",
            "properties": {
              "node": {
                "type": "string",
                "description": "节点 ID；同一节点可出现多次，所有节点至少出现一次才会都被点亮。"
              },
              "beats": {
                "type": "number",
                "minimum": 0.25,
                "maximum": 16,
                "description": "这一和弦占几拍；下一和弦在这之后进入。"
              },
              "level": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 1,
                "description": "力度，0.1 极轻，1 最强。"
              },
              "roll": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.6,
                "description": "可选：和弦由低到高依次发声的总秒数；省略为同时发声。"
              },
              "release": {
                "type": "number",
                "minimum": 0.2,
                "maximum": 6,
                "description": "可选：和弦结束后的淡出秒数。"
              }
            },
            "required": [
              "node",
              "beats",
              "level"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "beat",
        "steps"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "artist",
    "title",
    "date",
    "start",
    "ending",
    "map",
    "nodes"
  ],
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "description": "稳定节点 ID；改歌名时保持不变。"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "identity": {
          "type": "object",
          "properties": {
            "evidence_type": {
              "enum": [
                "author",
                "cross-reference",
                "archive",
                "contextual-alias",
                "provisional"
              ]
            },
            "evidence_urls": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "format": "uri"
              },
              "uniqueItems": true
            },
            "note": {
              "type": "string"
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "title",
                  "reason"
                ],
                "additionalProperties": false
              }
            },
            "review": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "not-requested",
                    "pending",
                    "confirmed",
                    "corrected"
                  ]
                },
                "by": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "date": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "format": "date",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "by",
                "date",
                "note"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "enum": [
                          "confirmed",
                          "corrected"
                        ]
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "by": {
                        "type": "string",
                        "minLength": 1
                      },
                      "date": {
                        "type": "string",
                        "minLength": 1,
                        "format": "date",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "by": {
                        "type": "null"
                      },
                      "date": {
                        "type": "null"
                      }
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "evidence_type",
            "evidence_urls",
            "note",
            "candidates",
            "review"
          ],
          "additionalProperties": false,
          "description": "查证依据和人工决定分开保留；人工确认不改变原始证据类型。"
        },
        "clue": {
          "type": "object",
          "properties": {
            "zh": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "zh",
            "en"
          ],
          "additionalProperties": false
        },
        "hint": {
          "type": "object",
          "properties": {
            "zh": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "zh",
            "en"
          ],
          "additionalProperties": false
        },
        "next": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "description": "稳定节点 ID；改歌名时保持不变。"
          },
          "uniqueItems": true,
          "description": "谜底对应的下一首歌曲 ID；唯一可编辑的路径定义。"
        },
        "dead_ends": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "指向站外死胡同的可接受答案，可包含简繁体别名，不产生图中的新节点。"
        },
        "position": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "source": {
          "type": "object",
          "properties": {
            "douban_item": {
              "type": "string",
              "minLength": 1
            },
            "xiami": {
              "type": "string",
              "minLength": 1,
              "format": "uri"
            },
            "predecessors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
                    "description": "稳定节点 ID；改歌名时保持不变。"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "format": "uri"
                  }
                },
                "required": [
                  "id",
                  "title",
                  "url"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [],
          "additionalProperties": false,
          "description": "历史证据，前驱标题按来源原文保留；不用于生成当前路径。"
        },
        "open_answers": {
          "type": "array",
          "minItems": 1,
          "description": "已确认可接，但后续暂空的答案；不充当完整节点或原版死胡同。",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "clue": {
                "type": "null"
              },
              "next": {
                "type": "null"
              },
              "review": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "confirmed"
                  },
                  "by": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "date": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "format": "date",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "status",
                  "by",
                  "date",
                  "note"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "status": {
                          "enum": [
                            "confirmed",
                            "corrected"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "by": {
                          "type": "string",
                          "minLength": 1
                        },
                        "date": {
                          "type": "string",
                          "minLength": 1,
                          "format": "date",
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "by": {
                          "type": "null"
                        },
                        "date": {
                          "type": "null"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "title",
              "aliases",
              "clue",
              "next",
              "review"
            ],
            "additionalProperties": false
          }
        },
        "decoys": {
          "type": "array",
          "minItems": 1,
          "description": "玩家很可能输入、但不是这条线答案的歌（同曲异词的孪生歌、更有名的同题歌、线索里撞上的歌名）。命中时显示 message，而不是通用的「没有接上」；不算答对，也不计入提示催促。不得与本节点的任何可接答案重名。",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "message": {
                "type": "object",
                "properties": {
                  "zh": {
                    "type": "string",
                    "minLength": 1
                  },
                  "en": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "zh",
                  "en"
                ],
                "additionalProperties": false
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "description": "为什么列为诱饵（出处与核实），不进页面。"
              }
            },
            "required": [
              "title",
              "aliases",
              "message",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "route_audit": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "minLength": 1,
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "note": {
              "type": "string"
            },
            "confirmed_additions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "target": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
                    "description": "稳定节点 ID；改歌名时保持不变。"
                  },
                  "by": {
                    "type": "string",
                    "minLength": 1
                  },
                  "date": {
                    "type": "string",
                    "minLength": 1,
                    "format": "date",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "target",
                  "by",
                  "date",
                  "note"
                ],
                "additionalProperties": false
              }
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "title",
                  "reason"
                ],
                "additionalProperties": false
              }
            },
            "retired_routes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "target": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
                    "description": "稳定节点 ID；改歌名时保持不变。"
                  },
                  "by": {
                    "type": "string",
                    "minLength": 1
                  },
                  "date": {
                    "type": "string",
                    "minLength": 1,
                    "format": "date",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "target",
                  "by",
                  "date",
                  "note"
                ],
                "additionalProperties": false
              },
              "description": "作者明确替换的历史路径；保存旧证据，不再参与答案判断。"
            }
          },
          "required": [
            "date",
            "note",
            "confirmed_additions",
            "candidates"
          ],
          "additionalProperties": false,
          "description": "路径复核记录。候选不进入答案判断，confirmed_additions 记录原始前驱之外由作者确认的接线。"
        },
        "terminal": {
          "enum": [
            "dead-end",
            "epilogue"
          ],
          "description": "死胡同或隐藏尾声；均无出边。epilogue 必须对应顶层 bonus。"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "description": "作者提供的原文引用，独立于谜面展示。"
        },
        "clue_format": {
          "enum": [
            "prose",
            "quote"
          ],
          "description": "整段谜面引用歌词时用 quote；原文仍只维护在 clue 中。省略等同 prose。"
        },
        "presentation": {
          "type": "object",
          "properties": {
            "flower": {
              "enum": [
                "poppy",
                "blue",
                "ivory",
                "dahlia"
              ]
            },
            "flower_reason": {
              "type": "string",
              "minLength": 1
            },
            "chord": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "midi": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 48,
                    "maximum": 72
                  },
                  "minItems": 3,
                  "maxItems": 6,
                  "uniqueItems": true,
                  "description": "实际同时发声的配器，3–6 个音，MIDI 由低到高；C4 = 60。"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "midi",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "flower",
            "flower_reason",
            "chord"
          ],
          "additionalProperties": false,
          "description": "按歌曲意象设计的视觉与和声，不表示原曲调性。省略时使用蓝花与 Csus2。"
        }
      },
      "required": [
        "id",
        "title",
        "aliases",
        "identity",
        "clue",
        "hint",
        "next",
        "position"
      ],
      "additionalProperties": false
    }
  }
}
